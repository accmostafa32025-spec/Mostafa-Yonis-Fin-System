rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleDocExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return roleDocExists() && currentRole() == role;
    }

    function hasAnyRole(roles) {
      return roleDocExists() && currentRole() in roles;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.admin == true || hasRole('admin'));
    }

    function isActiveUser() {
      return roleDocExists() && currentRole() != 'pending';
    }

    function canMaintainMasterData() {
      return isAdmin() || hasAnyRole(['cfo', 'accounts_manager']);
    }

    function canEnterAccountingData() {
      return isAdmin() || hasAnyRole(['cfo', 'accounts_manager', 'accountant', 'data_entry']);
    }

    function canReviewEntries() {
      return isAdmin() || hasAnyRole(['cfo', 'accounts_manager', 'auditor']);
    }

    function canViewPayroll() {
      return isAdmin() || hasAnyRole(['cfo', 'accounts_manager']);
    }

    function isKnownRole(role) {
      return role in [
        'pending',
        'data_entry',
        'accountant',
        'auditor',
        'accounts_manager',
        'cfo',
        'admin',
        'view_only'
      ];
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Self-registration creates an unprivileged profile only.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'pending';

      // Users may update contact metadata, never their own role or permissions.
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoURL', 'lastLogin']);

      // Only a privileged administrator can assign or revoke roles.
      allow update: if isAdmin() &&
        isKnownRole(request.resource.data.role);
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /accounts/{documentId} {
      allow read: if isActiveUser();
      allow write: if canMaintainMasterData();
    }

    match /cost_centers/{documentId} {
      allow read: if isActiveUser();
      allow write: if canMaintainMasterData();
    }

    match /budgets/{documentId} {
      allow read: if isActiveUser();
      allow write: if canMaintainMasterData();
    }

    match /settings/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || hasRole('cfo');
    }

    match /journal_entries/{entryId} {
      allow read: if isActiveUser();
      allow create: if canEnterAccountingData() &&
        request.resource.data.status == 'draft';
      allow update: if isAdmin() || hasRole('cfo') ||
        (hasRole('accounts_manager')) ||
        (
          hasAnyRole(['accountant', 'data_entry']) &&
          resource.data.status in ['draft', 'rejected'] &&
          request.resource.data.status in ['draft', 'under_review']
        );
      allow delete: if isAdmin() || hasRole('cfo') ||
        (hasRole('accounts_manager') && resource.data.status in ['draft', 'rejected']);
    }

    match /members/{documentId} {
      allow read: if isActiveUser();
      allow write: if canEnterAccountingData();
    }

    match /suppliers/{documentId} {
      allow read: if isActiveUser();
      allow write: if canEnterAccountingData();
    }

    match /bank_accounts/{documentId} {
      allow read: if isActiveUser();
      allow write: if canMaintainMasterData();
    }

    match /checks/{documentId} {
      allow read: if isActiveUser();
      allow write: if canEnterAccountingData();
    }

    match /savings_uploads/{documentId} {
      allow read, write: if canViewPayroll();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || hasAnyRole(['cfo', 'accounts_manager', 'auditor']);
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // Deny by default: each collection must receive an explicit role policy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
